# Environments — nothing installs globally, and nothing installed is committed
backend/.venv/
frontend/node_modules/
node_modules/

# Python
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
*.egg-info/

# Next.js
.next/
out/
next-env.d.ts

# Secrets
.env
.env.*
!.env.example

# fastembed / HuggingFace model cache — downloaded at runtime, never committed
.fastembed_cache/
backend/.fastembed_cache/
.cache/

# Ronak's eval corpus — supplied locally, not part of the repo
corpus/

# Eval run artefacts. The findings live in obsidian_vault/Pipeline Review Log.md;
# the raw JSON is a per-run scratch file, and committing it would age badly the
# moment a threshold or the corpus changes.
evals/results/

# deepeval's telemetry directory. It is created on import, holds nothing we
# need, and reappears on every test run.
.deepeval/
backend/.deepeval/

# Agent tooling — local developer configuration, not part of the deliverable.
.claude/
.agents/
skills-lock.json

# Local data volumes
qdrant_storage/
pgdata/

# Eval output
evals/results/

# Scratch corpus used to probe the pipeline during the 2026-08-02 review. Not
# shipped - the reviewer brings their own documents, which is the point.
# Deliberately named exactly rather than globbed: `document corpus/` is tracked
# and is the demo set, so a loose `corpus*` pattern here would be a trap.
new_corpus/

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Next.js build output
frontend/.next/
frontend/out/
