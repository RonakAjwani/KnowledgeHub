# Copy to backend/.env and fill in. `docker compose up` works with this file as-is
# except for the LLM key — AUTH_MODE=dev needs no Clerk account.

APP_ENV=local
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# dev assigns every caller the same user_id and is refused unless APP_ENV is
# local or docker. Deployments must set clerk.
AUTH_MODE=dev
CLERK_SECRET_KEY=
CLERK_AUTHORIZED_PARTIES=

# Compose overrides both of these with the in-network service names.
DATABASE_URL=postgresql+asyncpg://knowledgehub:knowledgehub@localhost:5432/knowledgehub
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
QDRANT_COLLECTION=chunks

# Swapping providers is a config change, never a code change.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=

# Rerank is optional by design: with no key the fallback chain runs on fused
# order and says so via a degradation event, rather than failing the query.
COHERE_API_KEY=

# Accepted technique, shipped off — see config.py.
CONTEXTUAL_RETRIEVAL=false
